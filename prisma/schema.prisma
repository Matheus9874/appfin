// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  transactions Transaction[]
  investments  Investment[]
  goals        Goal[]
  categories   Category[]
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum NaturezaCusto {
  FIXO
  VARIAVEL
}

model Category {
  id           String         @id @default(cuid())
  userId       String
  nome         String
  tipo         TipoTransacao
  natureza     NaturezaCusto?
  user         User           @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, nome, tipo])
  @@index([userId])
}

model Transaction {
  id         String        @id @default(cuid())
  userId     String
  tipo       TipoTransacao
  valor      Decimal       @db.Decimal(10, 2)
  categoryId String
  descricao  String
  data       DateTime
  user       User          @relation(fields: [userId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])

  @@index([userId])
}

enum InvestmentType {
  POUPANCA
  TESOURO_DIRETO
  CDB
  ACOES
  FUNDOS
  RESERVA_EMERGENCIA
  OUTRO
}

model Investment {
  id           String         @id @default(cuid())
  userId       String
  tipo         InvestmentType
  instituicao  String
  nome         String?
  valor        Decimal        @db.Decimal(12, 2)
  data         DateTime
  user         User           @relation(fields: [userId], references: [id])
  goals        Goal[]

  @@index([userId])
}

model Goal {
  id           String      @id @default(cuid())
  userId       String
  nome         String
  valorAlvo    Decimal     @db.Decimal(12, 2)
  prazo        DateTime
  investmentId String?
  user         User        @relation(fields: [userId], references: [id])
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  @@index([userId])
}
