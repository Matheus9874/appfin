// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  transactions         Transaction[]
  investments          Investment[]
  goals                Goal[]
  categories           Category[]
  chatMessages         ChatMessage[]
  pluggyItems          PluggyItem[]
  pluggyAccounts       PluggyAccount[]
  monthlyPlans         MonthlyPlan[]
  dismissedSuggestions DismissedSuggestion[]
  fixedBills           FixedBill[]
  fixedBillMatches     FixedBillMatch[]
}

enum TipoTransacao {
  RECEITA
  DESPESA
}

enum NaturezaCusto {
  FIXO
  VARIAVEL
}

model Category {
  id           String         @id @default(cuid())
  userId       String
  nome         String
  tipo         TipoTransacao
  natureza     NaturezaCusto?
  user         User           @relation(fields: [userId], references: [id])
  transactions Transaction[]
  fixedBills   FixedBill[]

  @@unique([userId, nome, tipo])
  @@index([userId])
}

enum OrigemTransacao {
  MANUAL
  PLUGGY
}

enum MeioPagamento {
  PIX
  DEBITO
  CREDITO
  TED
  DOC
  BOLETO
  OUTRO
}

model Transaction {
  id                   String          @id @default(cuid())
  userId               String
  tipo                 TipoTransacao
  valor                Decimal         @db.Decimal(10, 2)
  categoryId           String
  descricao            String
  data                 DateTime
  origem               OrigemTransacao @default(MANUAL)
  pluggyTransactionId  String?         @unique
  meioPagamento        MeioPagamento?
  natureza             NaturezaCusto?
  // Movimentação entre contas/ativos do próprio usuário (pagamento de fatura
  // de cartão, aporte em investimento) — não é receita/despesa real, então
  // fica de fora das somas de saldo, mas continua visível na listagem. A
  // categoria original é preservada de propósito (ver lib/pluggyTransferDetection.ts).
  transferenciaInterna Boolean         @default(false)
  user                 User            @relation(fields: [userId], references: [id])
  category             Category        @relation(fields: [categoryId], references: [id])
  fixedBillMatch       FixedBillMatch?

  @@index([userId])
}

enum InvestmentType {
  POUPANCA
  TESOURO_DIRETO
  CDB
  ACOES
  FUNDOS
  RESERVA_EMERGENCIA
  OUTRO
}

model Investment {
  id                 String          @id @default(cuid())
  userId             String
  tipo               InvestmentType
  instituicao        String
  nome               String?
  valor              Decimal         @db.Decimal(12, 2)
  data               DateTime
  origem             OrigemTransacao @default(MANUAL)
  pluggyInvestmentId String?         @unique
  user               User            @relation(fields: [userId], references: [id])
  goals              Goal[]

  @@index([userId])
}

model Goal {
  id           String      @id @default(cuid())
  userId       String
  nome         String
  valorAlvo    Decimal     @db.Decimal(12, 2)
  prazo        DateTime
  investmentId String?
  user         User        @relation(fields: [userId], references: [id])
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: SetNull)

  @@index([userId])
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      ChatRole
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model PluggyItem {
  id             String          @id @default(cuid())
  userId         String
  pluggyItemId   String          @unique
  connectorName  String
  createdAt      DateTime        @default(now())
  lastSyncedAt   DateTime?
  user           User            @relation(fields: [userId], references: [id])
  pluggyAccounts PluggyAccount[]

  @@index([userId])
}

enum PluggyAccountType {
  BANK
  CREDIT
}

/**
 * A bank/credit account under a connected Pluggy item, with its real balance
 * as reported by the institution — used for "Saldo total" instead of
 * reconstructing a balance from imported transactions, which only cover the
 * sync window and can't reflect the true starting balance.
 */
model PluggyAccount {
  id               String            @id @default(cuid())
  userId           String
  pluggyItemId     String
  pluggyAccountId  String            @unique
  tipo             PluggyAccountType
  nome             String
  saldo            Decimal           @db.Decimal(12, 2)
  // Só preenchido para contas tipo CREDIT: a fatura atual em aberto é o
  // próprio `saldo` da conta; `vencimentoFatura` é a data de vencimento
  // informada pela instituição (creditData.balanceDueDate no Pluggy).
  vencimentoFatura DateTime?
  atualizadoEm     DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  pluggyItem       PluggyItem        @relation(fields: [pluggyItemId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Como o usuário planeja dividir a renda de um mês em 4 fatias grandes
 * (essencial/pessoal/reserva/investimento) — guardado em percentuais (não
 * valores absolutos) pra continuar válido se a renda mudar de um mês pro
 * outro; o valor em R$ de cada fatia é sempre `rendaPlanejada * percentual`,
 * calculado na hora de exibir. Ver lib/monthlyPlanActuals.ts para o cálculo
 * do "realizado" que é comparado com isso.
 */
model MonthlyPlan {
  id                     String  @id @default(cuid())
  userId                 String
  mes                    Int
  ano                    Int
  rendaPlanejada         Decimal @db.Decimal(12, 2)
  percentualEssencial    Decimal @db.Decimal(5, 2)
  percentualPessoal      Decimal @db.Decimal(5, 2)
  percentualReserva      Decimal @db.Decimal(5, 2)
  percentualInvestimento Decimal @db.Decimal(5, 2)
  user                   User    @relation(fields: [userId], references: [id])

  @@unique([userId, mes, ano])
  @@index([userId])
}

/**
 * Comerciante/descrição que o usuário já revisou numa versão anterior da
 * sugestão automática de Fixo/Variável e decidiu que não era relevante —
 * tabela mantida por compatibilidade, sem uso ativo depois da migração
 * pra Contas Fixas (ver FixedBill).
 */
model DismissedSuggestion {
  id        String   @id @default(cuid())
  userId    String
  chave     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, chave])
  @@index([userId])
}

/**
 * Conta fixa cadastrada manualmente pelo usuário (Aluguel, Água, parcela
 * do carro etc.), com uma faixa de valor esperado — ver
 * lib/fixedBillMatching.ts pro algoritmo que casa isso com transações
 * reais todo mês (guardado em FixedBillMatch, não aqui).
 */
model FixedBill {
  id               String           @id @default(cuid())
  userId           String
  nome             String
  valorEsperado    Decimal          @db.Decimal(12, 2)
  valorMin         Decimal          @db.Decimal(12, 2)
  valorMax         Decimal          @db.Decimal(12, 2)
  categoryId       String?
  /// Descrições normalizadas (ver lib/fixedBillMatching.ts) já confirmadas
  /// manualmente pra essa conta — um mesmo estabelecimento pode cobrar em
  /// mais de um formato de texto (ex.: débito direto vs. boleto do mesmo
  /// banco), então cada confirmação manual ACRESCENTA um padrão à lista em
  /// vez de substituir o anterior. Junto com a faixa de valor, qualquer
  /// padrão da lista permite vincular automaticamente sem pedir
  /// confirmação de novo.
  textosAprendidos String[]         @default([])
  user             User             @relation(fields: [userId], references: [id])
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  matches          FixedBillMatch[]

  @@index([userId])
}

enum FixedBillMatchStatus {
  AUTOMATICO
  MANUAL
  NAO_ENCONTRADA
}

/**
 * O resultado, pra um (FixedBill, mês) específico, de rodar
 * lib/fixedBillMatching.ts — não existir uma linha pra um par (conta, mês)
 * significa "ainda não resolvido" (pendente/ambíguo), recalculado ao vivo
 * a cada carregamento em vez de guardado, pra nunca ficar desatualizado.
 * `transactionId` null = marcado manualmente como "não encontrada este
 * mês"; @unique nele impede duas contas reivindicarem a mesma transação.
 */
model FixedBillMatch {
  id            String               @id @default(cuid())
  fixedBillId   String
  userId        String
  mes           Int
  ano           Int
  transactionId String?              @unique
  status        FixedBillMatchStatus
  fixedBill     FixedBill            @relation(fields: [fixedBillId], references: [id], onDelete: Cascade)
  user          User                 @relation(fields: [userId], references: [id])
  transaction   Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([fixedBillId, mes, ano])
  @@index([userId])
}
